# dependencies
/node_modules
/.pnpm

# next.js build output
/.next/
/out/
/build

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# quarto render artifacts. The published output is public/report/index.html,
# copied from this intermediate, so the intermediate itself is not tracked.
/.quarto/
/report/.quarto/
/report/report.html
*_files/

# datasets: only the reproducible sample is tracked.
# Full captures and simulation outputs stay local.
/data/*.json
!/data/sample-data.json
